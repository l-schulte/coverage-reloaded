import path from 'path'
import vue from '@vitejs/plugin-vue'
import vueJsx from '@vitejs/plugin-vue-jsx'
import viteSSR from 'vite-ssr/plugin'
import { loadEnv, defineConfig } from 'vite'

/**
 * Istanbul instrumentation for Cypress code coverage.
 * Only loaded when running under Cypress (process.env.CYPRESS is set).
 * This instruments the source code with __coverage__ so that
 * @cypress/code-coverage can collect it.
 */
import istanbul from 'vite-plugin-istanbul'

const resolve = file => path.resolve(__dirname, file)

export default defineConfig(({ mode }) => {
  Object.assign(process.env, loadEnv(mode, process.cwd(), ''))

  return {
    root: path.resolve(__dirname, 'dev'),
    server: {
      port: process.env.PORT,
      strictPort: !!process.env.PORT,
    },
    resolve: {
      alias: [
        { find: /^vuetify$/, replacement: resolve('./src/entry-bundler.ts') },
        { find: /^vuetify\/(.*)/, replacement: resolve('./$1') },
        { find: /^@\/(.*)/, replacement: resolve('./src/$1')}
      ]
    },
    plugins: [
      vue(),
      vueJsx({ optimize: true, enableObjectSlots: false }),
      viteSSR(),
      {
        name: 'configure-server',
        configureServer(server) {
          return () => {
            server.middlewares.use('/', (req, res, next) => {
              if (req.url === '/index.html') req.url = '/index.vite.html'
              return next()
            })
          }
        }
      }
      // Instrument source code for Cypress code coverage collection
      ...(process.env.CYPRESS ? [istanbul({
        cypress: true,
        requireEnv: false,
      }] : []),
    ],
  }
})
