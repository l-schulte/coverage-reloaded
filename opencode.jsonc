{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "ref/*.md"],

  "command": {
    "container-debug": {
      "template": "Project $1 at commit $2: debug the test environment. Use the container-debug skill: read projects/$1/commits.csv to find timestamp, package_manager, and node_version for commit $2, then run bash docker-run.sh $1 shell $2 <timestamp> <pm> <node>. Inside the container, modify install-and-run.sh to interrupt at the desired point with 'exit 0', then run bash execute.sh to set up the environment and debug interactively. See .opencode/skills/container-debug.md for details.",
      "description": "Debug environment setup for a specific commit in a container"
    },
    "log-review": {
      "template": "Review the most recent log files for project $1. Use the log-review skill: read projects/$1/logs/*.log and projects/$1/logs/*.error, then group and summarize hard failures (coverage collection aborted) and soft failures (test failures) by commit. Analyze which failures are due to environment setup issues (we fix those) versus test code issues (if the developers faced these too, we do not fix them).",
      "description": "Analyze and summarize log files for a project to identify failures"
    },
    "new-project": {
      "template": "Project $1 was just added. Conduct a preliminary feasibility assessment. Use the new-project skill: read projects/$1/command_changes.csv to understand how commands progressed troughout the relevant timeframe (01-2021 to 01-2026). Group commands by type (unit test, integration tests, e2e test, important setup). Propose how coverage can be collected for unit and integration tests.",
      "description": "Assess the feasibility of a new project for coverage analysis"
    },
    "failure-label-review": {
      "template": "Review the labeled failures for project $1. Use the labeled-failure-analysis skill: confirm projects/$1/failure_labels_project.csv exists (else run python3 check_failures.py --project $1 --dedup project), then run python3 collapse_labels.py $1 to build projects/$1/failure_labels_collapsed_problematic_unclear.csv. Re-assess each problematic/unclear error family one-by-one: decide whether it is really our setup (problematic), actually a dev-facing test failure you mislabeled (acceptable), or still unclear. For genuinely problematic families recommend a commit-era-aware, non-breaking fix located in install-and-run.sh, Dockerfile, or OVERVIEW.md. Do not edit files or launch containers without permission.",
      "description": "Re-assess labeled problematic/unclear failures and recommend era-aware fixes"
    },
    "generate-failure-patterns": {
      "template": "Generate failure_patterns.json for project $1. Use the generate-failure-patterns skill: read projects/$1/install-and-run.sh to enumerate suite_start markers and their test runners, then inspect the unsuffixed projects/$1/logs/*.log to learn the project's actual failure-output vocabulary. Propose tight general.patterns/exclude plus per-suite add/remove overrides that anchor on the REAL error (not just the failing test name/file line), self-validate with python3 check_failures.py --project $1 --dry-run and by reading the 40 lines below sampled hits, then present the JSON for approval. Leave auto_classify empty — that is filled manually with check_failures.py.",
      "description": "Derive and propose a per-project failure_patterns.json for check_failures.py"
    }
  }
}
